:t1     rdf:type           time:Interval;
        time:hasBeginning  :t1b;
        time:hasEnd        :t1e;
        :includes          :t_instant_inside_t1;
        :intersects        :t_after_t1 , _:b0 , :t_anytime_before_t1 , :t_including_t_after_t1 , :t_including_t1 , :t_instant_inside_t1 .

