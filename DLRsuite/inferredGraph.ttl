        :intersects        _:b1 , :t_after_t1e , :t_after_t1 , :t_10minutes_after_t1 , :t_instant_inside_t1 , :t_including_t1e , :t1e , :t1 , _:b0 , :t_including_t1 , :t_anytime_before_t1 .

:t_including_t_after_t1e
        rdf:type            time:Interval , time:Instant;
        time:inXSDDateTime  "2026-01-05T22:00:00Z"^^xsd:dateTime .

