        time:inXSDDateTime  "2025-12-31T10:00:00Z"^^xsd:dateTime;
        :intersects         :t_anytime_before_t1 , :t_including_t2 .

:t2e    rdf:type            time:Interval , time:Instant;
        time:inXSDDateTime  "2025-12-31T20:00:00Z"^^xsd:dateTime;
        :intersects         :t_anytime_before_t1 , :t_including_t2 .

:t_anytime_before_t1  rdf:type  time:Interval;
        time:hasBeginning  :mi;
        time:hasEnd        :t1b;
        :includes          :t_before_t2 , :t_before_t1 , :t_including_t2e , :t_including_t2b , :t_including_t2 , :t_including_t1b , :t_anytime_before_t2 , :t2e , :t2b , :t2;
        :intersects        :t_including_t1 , :t_including_t_after_t1 , :t1 , :t2 , :t2b , :t2e , :t_anytime_before_t2 , :t_including_t1b , :t_including_t2 , :t_including_t2b , :t_including_t2e , :t_before_t1 , :t_before_t2 .

:t_anytime_before_t2  rdf:type  time:Interval;
        time:hasBeginning  :mi;
        time:hasEnd        :t2b;
        :includes          :t_before_t2 , :t_including_t2b;
        :intersects        :t_including_t2 , :t2 , :t_before_t2 , :t_including_t2b , :t_anytime_before_t1 .

:t_including_t1  rdf:type  time:Interval;
        time:hasBeginning  :t_including_t1b;
        time:hasEnd        :t_including_t1e;
        :includes          :t_10minutes_after_t1 , :t_before_t1 , :t_instant_inside_t1 , :t1e , :t1b , :t1;
        :intersects        :t1 , :t1b , :t1e , :t_instant_inside_t1 , :t_before_t1 , :t_10minutes_after_t1 , :t_after_t1 , _:b0 , :t_including_t_after_t1 , :t_anytime_before_t1 .

