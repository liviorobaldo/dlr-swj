        time:inXSDDateTime  "2026-01-01T16:00:00Z"^^xsd:dateTime;
        :includes           :t_before_t1;
        :intersects         :t_before_t1 , :t_anytime_before_t1 .

:t_including_t1e  rdf:type  time:Interval , time:Instant;
        time:inXSDDateTime  "2026-01-01T19:00:00Z"^^xsd:dateTime;
        :intersects         :t_including_t_after_t1 , :t_after_t1 , _:b0 .

:t_including_t2  rdf:type  time:Interval;
        time:hasBeginning  :t_including_t2b;
        time:hasEnd        :t_including_t2e;
        :includes          :t_before_t2 , :t2e , :t2b , :t2;
        :intersects        :t_anytime_before_t1 , :t_anytime_before_t2 , :t2 , :t2b , :t2e , :t_before_t2 .

