@prefix : <https://w3id.org/ontology/dlr#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix time: <http://www.w3.org/2006/time#> .
@base <https://w3id.org/ontology/dlr#> .

####################################################################################################################################################################
# Description:
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Test cases for the SPARQL rules inferring :intersects and :includes.
#
# Each test case consists of a pair of temporal entities (:tpN1, :tpN2), where N identifies the test case.
#
# Each test case uses dateTimes from a different year, starting from 2026. This guarantees that temporal entities
# belonging to different pairs never intersect with or include one another.
#
# Expected results are provided as comments immediately after each test case. Readers can double-check these
# results in the file inferredGraph.ttl, which contains the output of the SPARQL rules.
#
####################################################################################################################################################################

####################################################################################################################################################################
# 1. Instant / Instant: same instant (2026)
####################################################################################################################################################################

:tp11 a time:Instant ; time:inXSDDateTime "2026-01-01T15:15:00Z"^^xsd:dateTime .
:tp12 a time:Instant ; time:inXSDDateTime "2026-01-01T15:15:00Z"^^xsd:dateTime .

# Expected:
# :tp11 :intersects :tp12 .
# :tp12 :intersects :tp11 .
# :tp11 :includes :tp12 .
# :tp12 :includes :tp11 .


####################################################################################################################################################################
# 2. Instant / Instant: different instants (2025)
####################################################################################################################################################################

:tp21 a time:Instant ; time:inXSDDateTime "2025-01-01T15:15:00Z"^^xsd:dateTime .
:tp22 a time:Instant ; time:inXSDDateTime "2025-01-02T15:15:00Z"^^xsd:dateTime .

# Expected:
# No :intersects or :includes triple between :tp21 and :tp22, in either direction.


####################################################################################################################################################################
# 3. Degenerate Interval / Instant: Instant before Interval (2024)
# N.B. A degenerate Interval is one whose beginning and end coincide; therefore, it is effectively an Instant.
####################################################################################################################################################################

:tp31 a time:Interval ;
    time:hasBeginning [ time:inXSDDateTime "2024-01-10T15:15:00Z"^^xsd:dateTime ] ;
    time:hasEnd [ time:inXSDDateTime "2024-01-10T15:15:00Z"^^xsd:dateTime ] .

:tp32 a time:Instant ; time:inXSDDateTime "2024-01-09T15:15:00Z"^^xsd:dateTime .

# Expected:
# No :intersects or :includes triple between :tp31 and :tp32, in either direction.


####################################################################################################################################################################
# 4. Degenerate Interval / Instant: same instant (2023)
####################################################################################################################################################################

:tp41 a time:Interval ;
    time:hasBeginning [ time:inXSDDateTime "2023-01-10T15:15:00Z"^^xsd:dateTime ] ;
    time:hasEnd [ time:inXSDDateTime "2023-01-10T15:15:00Z"^^xsd:dateTime ] .

:tp42 a time:Instant ; time:inXSDDateTime "2023-01-10T15:15:00Z"^^xsd:dateTime .

# Expected:
# :tp41 :intersects :tp42 .
# :tp42 :intersects :tp41 .
# :tp41 :includes :tp42 .
# :tp42 :includes :tp41 .


####################################################################################################################################################################
# 5. Degenerate Interval / Instant: instant after Interval (2022)
####################################################################################################################################################################

:tp51 a time:Interval ;
    time:hasBeginning [ time:inXSDDateTime "2022-01-10T15:15:00Z"^^xsd:dateTime ] ;
    time:hasEnd [ time:inXSDDateTime "2022-01-10T15:15:00Z"^^xsd:dateTime ] .

:tp52 a time:Instant ; time:inXSDDateTime "2022-01-11T15:15:00Z"^^xsd:dateTime .

# Expected:
# No :intersects or :includes triple between :tp51 and :tp52, in either direction.


####################################################################################################################################################################
# 6. Degenerate Interval / Degenerate Interval: before (2021)
####################################################################################################################################################################

:tp61 a time:Interval ;
    time:hasBeginning [ time:inXSDDateTime "2021-01-10T15:15:00Z"^^xsd:dateTime ] ;
    time:hasEnd [ time:inXSDDateTime "2021-01-10T15:15:00Z"^^xsd:dateTime ] .

