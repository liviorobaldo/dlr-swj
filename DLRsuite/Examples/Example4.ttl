# 36. Proper Interval / Proper Interval: After (1991)
####################################################################################################################################################################

:tp361 a time:Interval ;
    time:hasBeginning [ time:inXSDDateTime "1991-01-10T15:15:00Z"^^xsd:dateTime ] ;
    time:hasEnd [ time:inXSDDateTime "1991-01-20T15:15:00Z"^^xsd:dateTime ] .

:tp362 a time:Interval ;
    time:hasBeginning [ time:inXSDDateTime "1991-01-07T15:15:00Z"^^xsd:dateTime ] ;
    time:hasEnd [ time:inXSDDateTime "1991-01-09T15:15:00Z"^^xsd:dateTime ] .

# Expected:
# No :intersects or :includes triple between :tp361 and :tp362, in either direction.
